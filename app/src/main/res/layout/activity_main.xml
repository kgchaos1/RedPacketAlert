<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_red"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- ===================== 权限与状态 ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.RedAlert.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_status" />

                    <LinearLayout
                        android:id="@+id/rowNotifAccess"
                        style="@style/Widget.RedAlert.Row">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RedAlert.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_notification_access" />

                            <TextView
                                android:id="@+id/statusNotifAccess"
                                style="@style/TextAppearance.RedAlert.RowSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNotifAccess"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_open" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowOverlay"
                        style="@style/Widget.RedAlert.Row">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RedAlert.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_overlay" />

                            <TextView
                                android:id="@+id/statusOverlay"
                                style="@style/TextAppearance.RedAlert.RowSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOverlay"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_open" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowBattery"
                        style="@style/Widget.RedAlert.Row">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RedAlert.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_battery" />

                            <TextView
                                android:id="@+id/statusBattery"
                                style="@style/TextAppearance.RedAlert.RowSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBattery"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_open" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowListener"
                        style="@style/Widget.RedAlert.Row"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_listener" />

                        <TextView
                            android:id="@+id/statusListener"
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowWeChat"
                        style="@style/Widget.RedAlert.Row"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_wechat" />

                        <TextView
                            android:id="@+id/statusWeChat"
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== 总开关 ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.RedAlert.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_master" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/switch_enabled" />

                    <TextView
                        android:id="@+id/tvMasterHint"
                        style="@style/TextAppearance.RedAlert.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== 提醒方式 ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.RedAlert.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_channels" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_sound" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAlarmStream"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_alarm_stream" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvToneLabel"
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickTone"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_pick_tone" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swVibrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_vibrate" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swVibrateContinuous"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_vibrate_continuous" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swTorch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_torch" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swOverlayAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_overlay" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swScreenOn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_screen_on" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_duration" />

                        <TextView
                            android:id="@+id/tvDurationLabel"
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== 关键词 ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.RedAlert.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_keywords" />

                    <LinearLayout
                        android:id="@+id/rowKeywords"
                        style="@style/Widget.RedAlert.Row">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_keywords" />

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowExcludes"
                        style="@style/Widget.RedAlert.Row">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_excludes" />

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swIgnoreOngoing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_ignore_ongoing" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swIgnoreSuspended"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_ignore_suspended" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== 群聊范围 ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.RedAlert.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_scope" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swWhitelist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_whitelist" />

                    <LinearLayout
                        android:id="@+id/rowWhitelist"
                        style="@style/Widget.RedAlert.Row">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_whitelist" />

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowMute"
                        style="@style/Widget.RedAlert.Row">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_mute" />

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swMatchSender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_match_sender" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAlertUnknown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_alert_unknown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== 高级 ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RedAlert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.RedAlert.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_advanced" />

                    <LinearLayout
                        android:id="@+id/rowPackages"
                        style="@style/Widget.RedAlert.Row">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_packages" />

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_interval" />

                        <TextView
                            android:id="@+id/tvIntervalLabel"
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/rowLog"
                        style="@style/Widget.RedAlert.Row">

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_log" />

                        <TextView
                            style="@style/TextAppearance.RedAlert.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_test" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
